# NeonDB Serverless PostgreSQL Connection String
# Tip: Use the pooled connection string (-pooler in hostname) for serverless environments (e.g. Vercel)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/enerjanta?sslmode=require"

# Canonical Site URL (used for sitemap, robots, OpenGraph metadata, and JSON-LD)
NEXT_PUBLIC_SITE_URL="https://enerjanta.org"

# Analytics (Optional - scripts only load if values are present)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_CLARITY_ID="XXXXXXXXXX"

